{
  "manifest_version": 3,
  "name": "ClickFlow Lite — Multi-Box Sequence Recorder",
  "version": "1.1.0",
  "description": "Record click sequences across multiple text boxes and auto-paste lists item by item.",
  "action": {
    "default_popup": "index.html",
    "default_title": "ClickFlow Lite"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
